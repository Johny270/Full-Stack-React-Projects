{
    "presets": [
        ["@babel/preset-env",
            {
                "targets": {
                    "node": "current"
                }
            }
        ],
        "@babel/preset-react"
    ],
    "plugins": [
        "react-hot-loader/babel"
    ]
}
// In this configuration, we specify that we need Babel to transpile the
// latest JavaScript syntax with support for code in Node.js environment
// and also React/JSX code.
// The react-hot-loader/babel plugin is required by the react-hot-loader module
// to compile react components